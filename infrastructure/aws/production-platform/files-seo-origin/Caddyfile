# Shared public origin for EC2 Files, SEO and sandbox tool transport.
# Caddy obtains and renews publicly trusted certificates with ACME HTTP-01.
files.matrxserver.com {
	reverse_proxy 127.0.0.1:8080
}

seo.matrxserver.com {
	reverse_proxy 127.0.0.1:8081
}

# Dedicated orchestrator contract; sandbox.matrxserver.com was an AI Dream API.
# Create the Cloudflare-proxied DNS record before applying this configuration.
sandbox-orchestrator.matrxserver.com {
	reverse_proxy 127.0.0.1:8000
}
